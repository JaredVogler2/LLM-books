# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@crayonsandquills.com

# Print-on-Demand
PRINTFUL_API_KEY=
LULU_API_KEY=
LULU_API_SECRET=
BLURB_API_KEY=

# Sentry (Error Tracking)
SENTRY_DSN=

# App URLs
APP_URL=http://localhost:3000
