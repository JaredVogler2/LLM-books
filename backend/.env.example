# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://crayonsquills:crayonsquills_dev@localhost:5432/crayonsquills?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-a-256-bit-key
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me-too-different-key
JWT_REFRESH_EXPIRATION=30d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=crayons-and-quills-assets
