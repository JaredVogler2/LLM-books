# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://crayonsquills:crayonsquills_dev@localhost:5432/crayonsquills?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-a-256-bit-key
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me-too-different-key
JWT_REFRESH_EXPIRATION=30d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=crayons-and-quills-assets
S3_BUCKET_REGION=us-east-1

# Anthropic (primary: story generation + safety validation)
ANTHROPIC_API_KEY=
ANTHROPIC_STORY_MODEL=claude-opus-4-6
ANTHROPIC_SAFETY_MODEL=claude-haiku-4-5-20251001

# OpenAI (secondary: character vision analysis, structured prompts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# FAL.ai (Flux.2 Pro image generation with IP-Adapter for character consistency)
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1
FAL_IP_ADAPTER_MODEL=fal-ai/flux/dev/ip-adapter

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@crayonsandquills.com

# Print-on-Demand
PRINTFUL_API_KEY=
LULU_API_KEY=
LULU_API_SECRET=
BLURB_API_KEY=

# Sentry (Error Tracking)
SENTRY_DSN=

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
